# Quant Research Engine Configuration
# Copy this file to .env and adjust values as needed.

# Environment: development | testing | production
QUANT_ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
QUANT_LOG_LEVEL=INFO

# Default random seed for reproducible experiments
QUANT_DEFAULT_SEED=42

# Data directory for local storage (relative or absolute path)
QUANT_DATA_DIR=./data
